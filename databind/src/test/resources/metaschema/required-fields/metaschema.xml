<?xml version="1.0" encoding="UTF-8"?>
<METASCHEMA xmlns="http://csrc.nist.gov/ns/oscal/metaschema/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <schema-name>Required Fields Test</schema-name>
  <schema-version>1.0</schema-version>
  <short-name>required-fields-test</short-name>
  <namespace>http://csrc.nist.gov/ns/metaschema/testing/required-fields</namespace>
  <json-base-uri>http://csrc.nist.gov/ns/metaschema/testing/required-fields</json-base-uri>

  <define-assembly name="root">
    <formal-name>Root</formal-name>
    <description>Root assembly with required fields</description>
    <root-name>root</root-name>
    <flag ref="required-flag" required="yes" />
    <flag ref="optional-flag" />
    <model>
      <field ref="required-field" min-occurs="1" />
      <field ref="optional-field" />
      <assembly ref="required-assembly" min-occurs="1" />
      <assembly ref="optional-assembly" />
    </model>
  </define-assembly>

  <define-flag name="required-flag">
    <formal-name>Required Flag</formal-name>
    <description>A required flag</description>
  </define-flag>

  <define-flag name="optional-flag">
    <formal-name>Optional Flag</formal-name>
    <description>An optional flag</description>
  </define-flag>

  <define-field name="required-field">
    <formal-name>Required Field</formal-name>
    <description>A required field</description>
  </define-field>

  <define-field name="optional-field">
    <formal-name>Optional Field</formal-name>
    <description>An optional field</description>
  </define-field>

  <define-assembly name="required-assembly">
    <formal-name>Required Assembly</formal-name>
    <description>A required assembly</description>
    <flag ref="id" required="yes" />
  </define-assembly>

  <define-assembly name="optional-assembly">
    <formal-name>Optional Assembly</formal-name>
    <description>An optional assembly</description>
  </define-assembly>

  <define-flag name="id">
    <formal-name>Identifier</formal-name>
    <description>An identifier</description>
  </define-flag>
</METASCHEMA>
